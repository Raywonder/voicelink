# VoiceLink Audio is authenticated by default; engines remain unavailable until validated.
VOICELINK_AUDIO_ENABLED=true
# Store the real token in the approved server-side secret store; never commit it.
VOICELINK_AUDIO_INTERNAL_TOKEN=replace-with-a-long-random-secret
VOICELINK_AUDIO_ALLOWED_CALLERS=clawdia-teamtalk
VOICELINK_AUDIO_MAX_TEXT_CHARS=4000
VOICELINK_AUDIO_MAX_AUDIO_BYTES=8388608
VOICELINK_AUDIO_REQUESTS_PER_MINUTE=60

# Ordered candidates. A name alone never marks an engine ready.
VOICELINK_AUDIO_TTS_FALLBACK_ORDER=elevenlabs,openai,local
VOICELINK_AUDIO_STT_FALLBACK_ORDER=elevenlabs,openai,local
VOICELINK_AUDIO_TTS_PROVIDER=none
VOICELINK_AUDIO_STT_PROVIDER=none
VOICELINK_AUDIO_LOCAL_HELPER=/usr/local/libexec/voicelink-audio-helper

# Future adapters may use these server-only values. Do not add credentials here.
VOICELINK_AUDIO_TTS_URL=
VOICELINK_AUDIO_STT_URL=
